[Unit]
Description=Palimpsest local coding-agent session ingestion
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/Projects/Palimpsest
ExecStart=/usr/bin/python3 %h/Projects/Palimpsest/tools/palimpsest_ingest.py watch --discover --interval-seconds 5
Environment=PYTHONUNBUFFERED=1
Environment=PALIMPSEST_INGEST_BASE_URL=http://127.0.0.1:8090
Environment=PALIMPSEST_INGEST_STATE_PATH=%h/.local/state/palimpsest/ingest-state.json
EnvironmentFile=-%h/.config/palimpsest/ingest.env
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.local/state/palimpsest

[Install]
WantedBy=default.target
